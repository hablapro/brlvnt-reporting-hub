# Copy to .env and fill in. .env is gitignored. Never commit real values.
#
# Only three of the eight MCP servers need a secret. The rest authenticate
# server-side inside the Cloudflare Worker, so the URL alone is enough.
#
# Where to get these: Renzo / Berelvant ops holds the Cloudflare Worker
# secrets. Ask for the FX reporting MCP key bundle. See docs/SETUP.md.

# quantcast MCP — sent as the X-API-Key header
QUANTCAST_MCP_API_KEY=

# google-analytics MCP — sent as the Authorization header.
# Include the scheme if the key carries one (e.g. "Bearer xxx").
GA_MCP_AUTHORIZATION=

# cm360 MCP — sent as the X-API-Key header.
# Only needed for floodlight / trafficking QA, not for the monthly pull.
CM360_MCP_API_KEY=
